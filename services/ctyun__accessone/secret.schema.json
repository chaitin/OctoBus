{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ctyun_ak": {
      "type": "string",
      "description": "天翼云 Access Key (AK)，用于 EOP HMAC-SHA256 签名。",
      "x-octobus-smoke": "smoke-ak"
    },
    "ctyun_sk": {
      "type": "string",
      "description": "天翼云 Secret Key (SK)，用于 EOP HMAC-SHA256 签名。",
      "x-octobus-smoke": "smoke-sk"
    },
    "ak": {
      "type": "string",
      "description": "Alias for ctyun_ak."
    },
    "sk": {
      "type": "string",
      "description": "Alias for ctyun_sk."
    }
  },
  "required": ["ctyun_ak", "ctyun_sk"]
}
