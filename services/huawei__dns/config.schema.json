{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "endpoint": {
      "type": "string",
      "format": "uri",
      "default": "https://dns.myhuaweicloud.com",
      "description": "Huawei Cloud DNS API endpoint. HTTPS is required except for local smoke tests."
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "default": 10000,
      "description": "HTTP timeout in milliseconds."
    }
  }
}
