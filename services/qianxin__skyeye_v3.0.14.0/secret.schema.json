{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "oneOf": [
    { "required": ["skyeye_csrf_token"] },
    { "required": ["skyeye_login_key"] }
  ],
  "properties": {
    "skyeye_login_key": {
      "type": "string",
      "description": "SkyEye login key for dynamic authentication (preferred over csrf_token)."
    },
    "login_key": {
      "type": "string",
      "description": "Alias for skyeye_login_key."
    },
    "skyeye_csrf_token": {
      "type": "string",
      "description": "SkyEye CSRF token (legacy, use login_key instead)."
    },
    "csrf_token": {
      "type": "string",
      "description": "Alias for skyeye_csrf_token."
    }
  }
}
