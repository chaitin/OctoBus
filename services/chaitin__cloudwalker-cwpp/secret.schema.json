{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["token"],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "writeOnly": true,
      "description": "牧云 API Token，作为 Cookie: API-Token=<token> 发送。"
    }
  }
}
