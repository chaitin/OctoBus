{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "anyOf": [
    { "required": ["api_key"] },
    { "required": ["apiKey"] }
  ],
  "properties": {
    "api_key": {
      "type": "string",
      "description": "MISP API authentication key."
    },
    "apiKey": {
      "type": "string",
      "description": "Alias for api_key."
    }
  }
}
