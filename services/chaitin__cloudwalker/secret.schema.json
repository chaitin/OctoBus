{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string",
      "description": "CloudWalker API token header value."
    },
    "cookie": {
      "type": "string",
      "description": "Browser session cookie required by CloudWalker demo environment authentication."
    }
  },
  "required": ["token", "cookie"]
}
