{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "default": "https://otx.alienvault.com/api/v1",
      "description": "AlienVault OTX API base URL. Override only for compatible gateways or testing."
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "default": 10000,
      "description": "HTTP timeout in milliseconds."
    }
  }
}
