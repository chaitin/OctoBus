{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "username": {
      "type": "string",
      "description": "Alertmanager username for HTTP Basic Auth (optional)."
    },
    "user": {
      "type": "string",
      "description": "Alias for username."
    },
    "password": {
      "type": "string",
      "description": "Alertmanager password for HTTP Basic Auth (optional)."
    },
    "passwd": {
      "type": "string",
      "description": "Alias for password."
    },
    "bearerToken": {
      "type": "string",
      "description": "Bearer token for Authorization header."
    },
    "token": {
      "type": "string",
      "description": "Alias for bearerToken."
    }
  }
}