{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "apiId": {
      "type": "string",
      "description": "aTrust OpenAPI API ID, sent as X-Ca-Key."
    },
    "apiSecret": {
      "type": "string",
      "description": "aTrust OpenAPI API Secret used for HMAC-SHA256 signing."
    },
    "xCaKey": {
      "type": "string",
      "description": "Alias for apiId."
    },
    "xCaSecret": {
      "type": "string",
      "description": "Alias for apiSecret."
    }
  }
}
