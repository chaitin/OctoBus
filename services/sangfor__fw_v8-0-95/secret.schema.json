{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "username": {
      "type": "string",
      "description": "Sangfor administrator account with WEB API permission."
    },
    "user": {
      "type": "string",
      "description": "Alias for username."
    },
    "password": {
      "type": "string",
      "description": "Sangfor administrator password."
    },
    "token": {
      "type": "string",
      "description": "Optional existing Sangfor session token; avoids automatic login."
    }
  }
}
