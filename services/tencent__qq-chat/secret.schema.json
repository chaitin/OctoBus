{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "appId": {
      "type": "string",
      "description": "QQ Bot AppID."
    },
    "app_id": {
      "type": "string",
      "description": "Alias for appId."
    },
    "appSecret": {
      "type": "string",
      "description": "QQ Bot AppSecret."
    },
    "app_secret": {
      "type": "string",
      "description": "Alias for appSecret."
    },
    "clientSecret": {
      "type": "string",
      "description": "Alias for appSecret."
    },
    "client_secret": {
      "type": "string",
      "description": "Alias for appSecret."
    },
    "accessToken": {
      "type": "string",
      "description": "Pre-fetched AccessToken. If omitted, appId and appSecret are used to fetch one."
    },
    "access_token": {
      "type": "string",
      "description": "Alias for accessToken."
    }
  }
}
