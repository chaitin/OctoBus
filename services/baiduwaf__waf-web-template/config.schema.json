{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_base": {
      "type": "string",
      "format": "uri",
      "default": "https://bss.wf.bj.baidubce.com",
      "description": "API 基础地址，默认使用百度云 HTTPS endpoint"
    },
    "apiBase": {
      "type": "string",
      "description": "api_base 的别名（camelCase）"
    },
    "base_url": {
      "type": "string",
      "description": "api_base 的别名（snake_case）"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "default": 10000,
      "description": "HTTP 请求超时时间（毫秒），默认 10000"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "timeoutMs 的别名（snake_case）"
    },
    "maxResponseBytes": {
      "type": "integer",
      "minimum": 1,
      "default": 4194304,
      "description": "允许读取的最大上游响应字节数，默认 4 MiB"
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "description": "maxResponseBytes 的别名（snake_case）"
    },
    "skipTlsVerify": {
      "type": "boolean",
      "default": false,
      "description": "仅在测试环境连接自签名 HTTPS endpoint 时启用；生产环境不建议开启"
    },
    "tlsInsecureSkipVerify": {
      "type": "boolean",
      "default": false,
      "description": "skipTlsVerify 的别名"
    },
    "insecureSkipVerify": {
      "type": "boolean",
      "default": false,
      "description": "skipTlsVerify 的别名"
    },
    "headers": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "可选的额外 HTTP headers，会与内置 headers 合并"
    }
  }
}
