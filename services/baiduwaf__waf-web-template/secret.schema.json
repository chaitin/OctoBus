{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "access_key": {
      "type": "string",
      "description": "百度云 BCE Access Key"
    },
    "accessKey": {
      "type": "string",
      "description": "access_key 的别名（camelCase）"
    },
    "ak": {
      "type": "string",
      "description": "access_key 的别名（简写）"
    },
    "secret_key": {
      "type": "string",
      "description": "百度云 BCE Secret Key"
    },
    "secretKey": {
      "type": "string",
      "description": "secret_key 的别名（camelCase）"
    },
    "sk": {
      "type": "string",
      "description": "secret_key 的别名（简写）"
    }
  }
}
