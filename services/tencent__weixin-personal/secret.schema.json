{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "token": {
      "type": "string",
      "description": "iLink bot token returned by QR login."
    },
    "accessToken": {
      "type": "string",
      "description": "Alias for token."
    },
    "access_token": {
      "type": "string",
      "description": "Alias for token."
    },
    "baseUrl": {
      "type": "string",
      "description": "Account-specific iLink base URL returned by QR login."
    },
    "base_url": {
      "type": "string",
      "description": "Alias for baseUrl."
    },
    "accountId": {
      "type": "string",
      "description": "iLink account ID returned by QR login."
    },
    "account_id": {
      "type": "string",
      "description": "Alias for accountId."
    }
  }
}
