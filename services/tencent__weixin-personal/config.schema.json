{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "loginBaseUrl": {
      "type": "string",
      "default": "https://ilinkai.weixin.qq.com",
      "description": "iLink QR login API base URL."
    },
    "login_base_url": {
      "type": "string",
      "description": "Alias for loginBaseUrl."
    },
    "baseUrl": {
      "type": "string",
      "default": "https://ilinkai.weixin.qq.com",
      "description": "iLink account API base URL. QR login returns the preferred account base URL."
    },
    "base_url": {
      "type": "string",
      "description": "Alias for baseUrl."
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "default": 15000,
      "description": "Default HTTP timeout in milliseconds."
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Alias for timeoutMs."
    },
    "longPollTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "default": 35000,
      "description": "Default long-poll getupdates timeout in milliseconds."
    },
    "long_poll_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Alias for longPollTimeoutMs."
    },
    "botType": {
      "type": "string",
      "default": "3",
      "description": "iLink QR login bot_type."
    },
    "bot_type": {
      "type": "string",
      "description": "Alias for botType."
    },
    "botAgent": {
      "type": "string",
      "default": "OctoBus/0.1.0",
      "description": "base_info.bot_agent value used for iLink observability."
    },
    "bot_agent": {
      "type": "string",
      "description": "Alias for botAgent."
    },
    "routeTag": {
      "type": "string",
      "description": "Optional SKRouteTag header for routed iLink deployments."
    },
    "route_tag": {
      "type": "string",
      "description": "Alias for routeTag."
    },
    "printQrCode": {
      "type": "boolean",
      "default": true,
      "description": "Print the Weixin login QR code to the service terminal when StartLogin succeeds."
    },
    "print_qr_code": {
      "type": "boolean",
      "description": "Alias for printQrCode."
    },
    "autoStartLogin": {
      "type": "boolean",
      "default": true,
      "description": "Start Weixin QR login and wait for scan confirmation when the service process starts. If a token is already configured, startup skips QR login unless this is explicitly true."
    },
    "auto_start_login": {
      "type": "boolean",
      "description": "Alias for autoStartLogin."
    },
    "loginWaitTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "default": 480000,
      "description": "How long each startup QR login attempt waits for scan confirmation."
    },
    "login_wait_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Alias for loginWaitTimeoutMs."
    },
    "autoLoginRetryMs": {
      "type": "integer",
      "minimum": 100,
      "default": 3000,
      "description": "Delay before requesting a fresh startup QR code after an unsuccessful login attempt."
    },
    "auto_login_retry_ms": {
      "type": "integer",
      "minimum": 100,
      "description": "Alias for autoLoginRetryMs."
    },
    "autoStartReceiverAfterLogin": {
      "type": "boolean",
      "default": true,
      "description": "Start the long-poll receiver automatically after startup QR login succeeds."
    },
    "auto_start_receiver_after_login": {
      "type": "boolean",
      "description": "Alias for autoStartReceiverAfterLogin."
    },
    "accountId": {
      "type": "string",
      "description": "Default iLink account ID returned by QR login."
    },
    "account_id": {
      "type": "string",
      "description": "Alias for accountId."
    },
    "autoStartReceiver": {
      "type": "boolean",
      "default": false,
      "description": "Start the long-poll receiver when the service process starts."
    },
    "auto_start_receiver": {
      "type": "boolean",
      "description": "Alias for autoStartReceiver."
    },
    "maxBufferedMessages": {
      "type": "integer",
      "minimum": 1,
      "default": 1000,
      "description": "Maximum received messages kept in memory."
    },
    "max_buffered_messages": {
      "type": "integer",
      "minimum": 1,
      "description": "Alias for maxBufferedMessages."
    },
    "receiverRetryMs": {
      "type": "integer",
      "minimum": 100,
      "default": 2000,
      "description": "Receiver retry delay after transient poll failures."
    },
    "receiver_retry_ms": {
      "type": "integer",
      "minimum": 100,
      "description": "Alias for receiverRetryMs."
    }
  }
}
