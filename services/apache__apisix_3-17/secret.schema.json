{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "adminApiKey": {
      "type": "string",
      "description": "Apache APISIX Admin API key sent as X-API-KEY."
    },
    "admin_api_key": {
      "type": "string",
      "description": "Legacy alias for adminApiKey."
    },
    "apiKey": {
      "type": "string",
      "description": "Legacy alias for adminApiKey."
    }
  },
  "required": [
    "adminApiKey"
  ]
}
