{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "username": {
      "type": "string",
      "description": "OpenObserve username (email) for HTTP Basic Auth."
    },
    "user": {
      "type": "string",
      "description": "Alias for username."
    },
    "password": {
      "type": "string",
      "description": "OpenObserve password for HTTP Basic Auth."
    },
    "passwd": {
      "type": "string",
      "description": "Alias for password."
    },
    "token": {
      "type": "string",
      "description": "OpenObserve API token (alternative to username/password)."
    },
    "apiToken": {
      "type": "string",
      "description": "Alias for token."
    }
  }
}