{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "webhook": {
      "type": "string",
      "description": "Feishu group robot webhook URL."
    },
    "webhook_url": {
      "type": "string",
      "description": "Deprecated alias for webhook."
    },
    "webhookUrl": {
      "type": "string",
      "description": "Deprecated alias for webhook."
    },
    "url": {
      "type": "string",
      "description": "Deprecated alias for webhook."
    },
    "appId": {
      "type": "string",
      "minLength": 1,
      "description": "Feishu custom application App ID used only by approval and contact methods."
    },
    "appSecret": {
      "type": "string",
      "minLength": 1,
      "description": "Feishu custom application App Secret used only by approval and contact methods."
    }
  }
}
