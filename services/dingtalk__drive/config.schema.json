{
  "schema": "chaitin.octobus.config.v1",
  "properties": {
    "dwsPath": {
      "type": "string",
      "description": "dws CLI executable path",
      "default": "dws"
    },
    "defaultSpaceId": {
      "type": "string",
      "description": "Default drive space ID for uploads",
      "default": ""
    },
    "dwsTimeout": {
      "type": "integer",
      "description": "Default timeout for dws commands in milliseconds",
      "default": 120000
    }
  }
}
