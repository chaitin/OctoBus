{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["username", "password"],
  "additionalProperties": false,
  "properties": {
    "username": {
      "type": "string",
      "minLength": 1,
      "description": "WAF login username"
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "description": "Plaintext WAF password. The service hashes it with SHA-256 before login."
    }
  }
}
