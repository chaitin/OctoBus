{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "token": {
      "type": "string",
      "description": "Kubernetes bearer token for authentication."
    },
    "bearerToken": {
      "type": "string",
      "description": "Alias for token."
    },
    "username": {
      "type": "string",
      "description": "Username for HTTP Basic Auth (alternative to token)."
    },
    "user": {
      "type": "string",
      "description": "Alias for username."
    },
    "password": {
      "type": "string",
      "description": "Password for HTTP Basic Auth."
    },
    "passwd": {
      "type": "string",
      "description": "Alias for password."
    }
  }
}